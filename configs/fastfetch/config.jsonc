{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "   → ",
    "color": {
      "separator": "38;2;58;64;68",
    },
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch.txt",
    "color": {
      "1": "38;2;139;175;196",
      "2": "38;2;143;194;173",
      "3": "38;2;166;153;196",
    },
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}     {at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "38;2;221;226;230",
        "at": "38;2;80;90;97",
        "host": "38;2;221;226;230",
      },
    },
    {
      "type": "separator",
      "string": "─────────────",
      "outputColor": "38;2;80;90;97",
    },
    {
      "type": "os",
      "key": "os       ",
      "format": "{2}",
      "keyColor": "38;2;139;175;196",
    },
    {
      "type": "uptime",
      "key": "uptime   ",
      "format": "{2}h {4}m",
      "keyColor": "38;2;139;175;196",
    },
    {
      "type": "packages",
      "key": "pkgs     ",
      "format": "{}",
      "keyColor": "38;2;139;175;196",
    },
    {
      "type": "wm",
      "key": "wm       ",
      "format": "{2}",
      "keyColor": "38;2;139;175;196",
    },
    {
      "type": "memory",
      "key": "memory   ",
      "format": "{1} ({3})",
      "keyColor": "38;2;139;175;196",
    },
    {
      "type": "custom",
      "format": " {##8bafc4}●{#} {##a8c292}●{#} {##c2bf88}●{#} {##c4a98a}●{#} {##a699c4}●{#} {##8fc2ad}●{#}",
    },
  ],
}
