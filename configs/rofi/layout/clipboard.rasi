@import "../colors.rasi"

configuration {
    show-icons:  false;
    font:        "JetBrains Mono Light 10";
    cycle:       false;
}

* {
    background-color: @bg-raised;
    text-color:       @text-base;
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    background-color: @bg-raised;
    border:           1px solid;
    border-color:     @bg-border;
    border-radius:    12px;
    width:            500px;
    location:         center;
    cursor:           "default";
}

mainbox {
    background-color: transparent;
    spacing:          0px;
    children:         [ "header", "inputbar", "listview" ];
}

header {
    background-color: @bg-overlay;
    border-radius:    12px 12px 0px 0px;
    border:           0px 0px 1px 0px solid;
    border-color:     @bg-border;
    padding:          14px 14px;
    spacing:          0px;
    orientation:      horizontal;
    expand:           false;
    children:         [ "textbox-title", "textbox-count" ];
}

textbox-title {
    str:              "CLIPBOARD HISTORY";
    font:             "JetBrains Mono Medium 9";
    text-color:       @text-muted;
    background-color: transparent;
    horizontal-align: 0;
    vertical-align:   0.5;
    expand:           true;
}

textbox-count {
    str:              "clipcat";
    font:             "JetBrains Mono Light 9";
    text-color:       @text-dim;
    background-color: transparent;
    horizontal-align: 1;
    vertical-align:   0.5;
    expand:           false;
}

inputbar {
    background-color: @bg-raised;
    border:           0px 0px 1px 0px solid;
    border-color:     @bg-border;
    padding:          10px 14px;
    spacing:          8px;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "󰍉";
    font:             "Symbols Nerd Font 12";
    text-color:       @text-dim;
    background-color: transparent;
    padding:          0px 6px 0px 0px;
    vertical-align:   0.5;
}

entry {
    text-color:        @text-base;
    background-color:  transparent;
    font:              "JetBrains Mono Light 10";
    placeholder:       "search clips...";
    placeholder-color: @text-dim;
    expand:            true;
    cursor:            text;
}

listview {
    background-color: transparent;
    padding:          8px;
    spacing:          2px;
    scrollbar:        false;
    fixed-height:     true;
    cursor:           "default";
}

element {
    background-color: transparent;
    border:           1px solid;
    border-color:     transparent;
    border-radius:    4px;
    padding:          10px 10px;
    cursor:           pointer;
    children:         [ "element-text" ];
}

element normal.normal {
    background-color: transparent;
    text-color:       @text-base;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @text-muted;
}

element normal.active {
    background-color: transparent;
    text-color:       @text-base;
}

element selected.normal {
    background-color: @bg-overlay;
    border-color:     @bg-border;
    text-color:       @text-base;
}

element selected.urgent {
    background-color: @bg-overlay;
    border-color:     @bg-border;
    text-color:       @text-bright;
}

element selected.active {
    background-color: @bg-overlay;
    border-color:     @bg-border;
    text-color:       @text-bright;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    expand:           true;
}
