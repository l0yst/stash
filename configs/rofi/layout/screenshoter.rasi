@import "../colors.rasi"

configuration {
    show-icons: false;
    font:       "DM Sans Regular 11";
    cycle:      false;
}

* {
    background-color: @bg-raised;
    text-color:       @text-base;
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    background-color: @bg-raised;
    border:           1px solid;
    border-color:     @bg-border;
    border-radius:    12px;
    width:            420px;
    location:         center;
    cursor:           "default";
}

mainbox {
    background-color: transparent;
    spacing:          0px;
    children:         [ "header", "listview", "footer" ];
}

header {
    background-color: @bg-overlay;
    border-radius:    12px 12px 0px 0px;
    border:           0px 0px 1px 0px solid;
    border-color:     @bg-border;
    padding:          14px 14px;
    spacing:          0px;
    orientation:      horizontal;
    expand:           false;
    children:         [ "textbox-title", "textbox-dir" ];
}

textbox-title {
    str:              "SCREENSHOT";
    font:             "JetBrains Mono Medium 9";
    text-color:       @text-muted;
    background-color: transparent;
    horizontal-align: 0;
    vertical-align:   0.5;
    expand:           true;
}

textbox-dir {
    str:              "maim";
    font:             "JetBrains Mono Light 9";
    text-color:       @text-dim;
    background-color: transparent;
    horizontal-align: 1;
    vertical-align:   0.5;
    expand:           false;
}

listview {
    background-color: transparent;
    padding:          8px;
    spacing:          2px;
    lines:            5;
    scrollbar:        false;
    fixed-height:     true;
    cursor:           "default";
}

element {
    background-color: transparent;
    border:           1px solid;
    border-color:     transparent;
    border-radius:    4px;
    padding:          8px 10px;
    cursor:           pointer;
    children:         [ "element-text" ];
}

element normal.normal {
    background-color: transparent;
    text-color:       @text-muted;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @text-muted;
}

element normal.active {
    background-color: transparent;
    text-color:       @text-muted;
}

element selected.normal {
    background-color: @bg-overlay;
    border-color:     @bg-border;
    text-color:       @text-base;
}

element selected.urgent {
    background-color: @bg-overlay;
    border-color:     @sky;
    text-color:       @text-base;
}

element selected.active {
    background-color: @bg-overlay;
    border-color:     @sky;
    text-color:       @text-base;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    expand:           true;
}

footer {
    background-color: @bg-overlay;
    border:           1px 0px 0px 0px solid;
    border-color:     @bg-border;
    border-radius:    0px 0px 12px 12px;
    padding:          8px 14px;
    expand:           false;
    children:         [ "textbox-footer" ];
}

textbox-footer {
    text-color:       @text-dim;
    background-color: transparent;
    font:             "JetBrains Mono Light 9";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    str:              "↵ capture    esc close";
    expand:           true;
}
