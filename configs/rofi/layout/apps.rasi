@import "../colors.rasi"

configuration {
    modi:                "drun";
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name}";
    font:                "DM Sans Regular 11";
    cycle:               false;
}

* {
    background-color: @bg-raised;
    text-color:       @text-base;
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    background-color: @bg-raised;
    border:           1px solid;
    border-color:     @bg-border;
    border-radius:    12px;
    width:            500px;
    location:         center;
    cursor:           "default";
}

mainbox {
    background-color: transparent;
    spacing:          0px;
    children:         [ "inputbar", "listview", "footer" ];
}

inputbar {
    background-color: @bg-overlay;
    border-radius:    12px 12px 0px 0px;
    border:           0px 0px 1px 0px solid;
    border-color:     @bg-border;
    padding:          18px 15px;
    spacing:          8px;
    children:         [ "textbox-prompt-colon", "entry", "num-filtered-rows" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "󰍉";
    font:             "Symbols Nerd Font 12";
    text-color:       @text-dim;
    background-color: transparent;
    padding:          0px 6px 0px 0px;
    vertical-align:   0.5;
}

entry {
    text-color:        @text-base;
    background-color:  transparent;
    font:              "JetBrains Mono Light 10";
    placeholder:       "Search Apps";
    placeholder-color: @text-dim;
    expand:            true;
    cursor:            text;
}

num-filtered-rows {
    expand:           false;
    text-color:       @text-dim;
    background-color: transparent;
    font:             "JetBrains Mono Light 10";
    padding:          0px 0px 0px 10px;
}

listview {
    background-color: transparent;
    padding:          8px;
    spacing:          2px;
    lines:            7;
    scrollbar:        false;
    fixed-height:     true;
    cursor:           "default";
}

element {
    background-color: transparent;
    border:           1px solid;
    border-color:     transparent;
    border-radius:    4px;
    padding:          10px 10px;
    spacing:          10px;
    cursor:           pointer;
    children:         [ "element-icon", "element-text" ];
}

element normal.normal {
    background-color: transparent;
    text-color:       @text-base;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @text-base;
}

element normal.active {
    background-color: transparent;
    text-color:       @text-base;
}

element selected.normal {
    background-color: @bg-overlay;
    border-color:     @bg-border;
    text-color:       @text-bright;
}

element selected.urgent {
    background-color: @bg-overlay;
    border-color:     @bg-border;
    text-color:       @text-bright;
}

element selected.active {
    background-color: @bg-overlay;
    border-color:     @bg-border;
    text-color:       @text-bright;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @text-base;
}

element alternate.urgent {
    background-color: transparent;
    text-color:       @text-base;
}

element alternate.active {
    background-color: transparent;
    text-color:       @text-base;
}


element-icon {
    size:             26px;
    border-radius:    4px;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    expand:           true;
    cursor:           inherit;
}

footer {
    background-color: @bg-overlay;
    border:           1px 0px 0px 0px solid;
    border-color:     @bg-border;
    border-radius:    0px 0px 12px 12px;
    padding:          10px 14px;
    expand:           false;
    children:         [ "textbox-footer" ];
}

textbox-footer {
    text-color:       @text-dim;
    background-color: transparent;
    font:             "JetBrains Mono Medium 9";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    str:              "󰌑 launch     ↑↓ navigate     esc close";
    expand:           true;
}
