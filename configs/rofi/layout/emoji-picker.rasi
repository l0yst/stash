@import "../colors.rasi"

configuration {
    show-icons: false;
    cycle:      false;
}

* {
    background-color: @bg-raised;
    text-color:       @text-base;
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    background-color: @bg-raised;
    border:           1px solid;
    border-color:     @bg-border;
    border-radius:    12px;
    width:            400px;
    location:         center;
    cursor:           "default";
}

mainbox {
    background-color: transparent;
    spacing:          0px;
    children:         [ "header", "inputbar", "listview", "footer" ];
}

header {
    background-color: @bg-overlay;
    border-radius:    12px 12px 0px 0px;
    border:           0px 0px 1px 0px solid;
    border-color:     @bg-border;
    padding:          14px;
    expand:           false;
    children:         [ "textbox-title" ];
}

textbox-title {
    str:              "EMOJI PICKER";
    font:             "JetBrains Mono Medium 9";
    text-color:       @text-muted;
    background-color: transparent;
    horizontal-align: 0;
    vertical-align:   0.5;
    expand:           true;
}

inputbar {
    background-color: @bg;
    border:           0px 0px 1px 0px solid;
    border-color:     @bg-border;
    padding:          10px 14px;
    spacing:          8px;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "󰍉";
    font:             "Symbols Nerd Font 12";
    text-color:       @text-dim;
    background-color: transparent;
    padding:          0px 6px 0px 0px;
    vertical-align:   0.5;
}

entry {
    text-color:        @text-base;
    background-color:  transparent;
    font:              "JetBrains Mono Light 10";
    placeholder:       "search emojis...";
    placeholder-color: @text-dim;
    expand:            true;
    cursor:            text;
}

listview {
    background-color: transparent;
    padding:          8px;
    spacing:          4px;
    columns:          8;
    lines:            5;
    scrollbar:        false;
    fixed-height:     true;
    fixed-columns:    true;
    dynamic:          false;
    cursor:           "default";
}

element {
    background-color: transparent;
    border:           1px solid;
    border-color:     transparent;
    border-radius:    4px;
    padding:          6px;
    cursor:           pointer;
    children:         [ "element-text" ];
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg-overlay;
    border-color:     @bg-border;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    expand:           true;
}

footer {
    background-color: @bg-overlay;
    border:           1px 0px 0px 0px solid;
    border-color:     @bg-border;
    border-radius:    0px 0px 12px 12px;
    padding:          10px 14px;
    expand:           false;
    children:         [ "textbox-footer" ];
}

textbox-footer {
    text-color:       @text-dim;
    background-color: transparent;
    font:             "JetBrains Mono Light 9";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    str:              "↵ copy   shift+↵ multi-select    esc close";
    expand:           true;
}
